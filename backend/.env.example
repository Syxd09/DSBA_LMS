# Environment
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edumetrics
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

