# ================================
# OBE Management System - Backend
# ================================

# Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5435/outcome_db?schema=public"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=24h

# CORS (Production only)
FRONTEND_URL=https://your-production-domain.com

# ================================
# PRODUCTION NOTES:
# ================================
# 1. JWT_SECRET must be a unique 256-bit (32+ character) random string
# 2. DATABASE_URL should point to production PostgreSQL
# 3. FRONTEND_URL must match your deployed frontend domain
# 4. Set NODE_ENV=production for production deployment
