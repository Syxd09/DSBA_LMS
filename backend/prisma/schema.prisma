generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  password                 String
  fullName                 String
  role                     Role                      @default(STUDENT)
  isActive                 Boolean                   @default(true)
  deletedAt                DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  avatarUrl                String?
  mobileNumber             String?
  departmentId             String?
  registrationNumber       String?                   @unique
  approvalDecisions        ApprovalRequest[]         @relation("Approver")
  approvalRequests         ApprovalRequest[]         @relation("Requester")
  auditLogs                AuditLog[]                @relation("AuditLogActor")
  attainmentsApproved      COAttainment[]            @relation("AttainmentApprover")
  conversationsCreated     Conversation[]            @relation("ConversationCreator")
  conversationParticipants ConversationParticipant[] @relation("ConversationParticipants")
  departmentLed            Department?               @relation("DepartmentHod")
  snapshotsCreated         ExamSnapshot[]
  feedbacksReceived        Feedback[]                @relation("StudentFeedback")
  feedbacksGiven           Feedback[]                @relation("TeacherFeedback")
  finalMarks               FinalMark[]
  computedMarks            MarksComputed[]
  unlockRequestsHOD        MarksUnlockRequest[]      @relation("UnlockHOD")
  unlockRequestsPrincipal  MarksUnlockRequest[]      @relation("UnlockPrincipal")
  unlockRequestsCreated    MarksUnlockRequest[]      @relation("UnlockRequester")
  sentMessages             Message[]                 @relation("SentMessages")
  messageReadReceipts      MessageReadReceipt[]      @relation("MessageReadReceipts")
  poAttainmentsApproved    POAttainment[]            @relation("POAttainmentApprover")
  semesterResults          SemesterResult[]
  studentEnrollments       StudentEnrollment[]
  marksEntered             StudentMark[]             @relation("MarksEnteredBy")
  marksReceived            StudentMark[]             @relation("StudentMarks")
  teacherAssignments       TeacherAssignment[]
  feedbackApprovals        TeacherStudentFeedback[]  @relation("FeedbackApprover")
  studentFeedbackReceived  TeacherStudentFeedback[]  @relation("StudentFeedbackReceived")
  teacherFeedbackGiven     TeacherStudentFeedback[]  @relation("TeacherFeedbackGiven")
  attendances              Attendance[]
  department               Department?               @relation("UserDepartment", fields: [departmentId], references: [id])
  presence                 UserPresence?             @relation("UserPresence")
}

model Department {
  id                 String              @id @default(uuid())
  name               String              @unique
  code               String              @unique
  hodId              String?             @unique
  isActive           Boolean             @default(true)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  hod                User?               @relation("DepartmentHod", fields: [hodId], references: [id])
  FeedbackTemplate   FeedbackTemplate[]
  gradingRules       GradingRule[]
  programs           Program[]
  studentEnrollments StudentEnrollment[]
  teacherAssignments TeacherAssignment[]
  users              User[]              @relation("UserDepartment")
  attendances        Attendance[]
}

model Program {
  id                String              @id @default(uuid())
  name              String
  code              String              @unique
  departmentId      String
  durationYears     Int                 @default(3)
  isActive          Boolean             @default(true)
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  cohorts           Cohort[]
  curricula         CurriculumVersion[]
  feedbackTemplates FeedbackTemplate[]
  attainments       POAttainment[]
  department        Department          @relation(fields: [departmentId], references: [id])
  programOutcomes   ProgramOutcome[]
}

model Cohort {
  id                 String                   @id @default(uuid())
  programId          String
  year               Int
  name               String
  currentSemester    Int                      @default(1)
  isActive           Boolean                  @default(true)
  deletedAt          DateTime?
  createdAt          DateTime                 @default(now())
  coAttainments      COAttainment[]
  program            Program                  @relation(fields: [programId], references: [id])
  exams              Exam[]
  finalMarks         FinalMark[]
  poAttainments      POAttainment[]
  semesterResults    SemesterResult[]
  enrollments        StudentEnrollment[]
  teacherAssignments TeacherAssignment[]
  teacherFeedbacks   TeacherStudentFeedback[]

  @@unique([programId, year])
}

model CurriculumVersion {
  id            String    @id @default(uuid())
  programId     String
  versionName   String
  effectiveFrom Int
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  program       Program   @relation(fields: [programId], references: [id])
  subjects      Subject[]
}

model Subject {
  id                  String                   @id @default(uuid())
  name                String
  code                String                   @unique
  credits             Int                      @default(3)
  semester            Int
  curriculumVersionId String
  isActive            Boolean                  @default(true)
  deletedAt           DateTime?
  createdAt           DateTime                 @default(now())
  coAttainments       COAttainment[]
  courseOutcomes      CourseOutcome[]
  exams               Exam[]
  finalMarks          FinalMark[]
  enrollments         StudentEnrollment[]
  curriculum          CurriculumVersion        @relation(fields: [curriculumVersionId], references: [id])
  teacherAssignments  TeacherAssignment[]
  teacherFeedbacks    TeacherStudentFeedback[]
  attendances         Attendance[]
}

/// Course learning outcomes (COs) defining specific skills students should achieve.
/// Each CO is mapped to subject topics and assessed through exam questions.
/// Attainment is calculated based on student performance against defined thresholds.
model CourseOutcome {
  id            String         @id @default(uuid())
  subjectId     String
  coNumber      Int
  description   String
  bloomLevel    BloomLevel
  createdAt     DateTime       @default(now())
  coAttainments COAttainment[]
  poMappings    CoPoMapping[]
  subject       Subject        @relation(fields: [subjectId], references: [id])
  questions     Question[]
  subQuestions  SubQuestion[]

  @@unique([subjectId, coNumber])
}

/// Program outcomes (POs) defining broad competencies graduates should possess.
/// Maps to NBA/NAAC accreditation requirements.
/// PO attainment is calculated as weighted average of related CO attainments.
model ProgramOutcome {
  id            String         @id @default(uuid())
  programId     String
  poNumber      Int
  description   String
  createdAt     DateTime       @default(now())
  targetPercent Float          @default(60)
  coMappings    CoPoMapping[]
  poAttainments POAttainment[]
  program       Program        @relation(fields: [programId], references: [id])

  @@unique([programId, poNumber])
}

/// CO-PO correlation mapping matrix for traceability.
/// Defines strength of correlation: 1 (Weak), 2 (Medium), 3 (Strong).
/// Used in PO attainment calculation as weighting factor.
model CoPoMapping {
  id               String         @id @default(uuid())
  coId             String
  poId             String
  correlationLevel Int
  co               CourseOutcome  @relation(fields: [coId], references: [id])
  po               ProgramOutcome @relation(fields: [poId], references: [id])

  @@unique([coId, poId])
}

/// Course Outcome attainment calculation results.
/// Stores percentage of students achieving target threshold (default 60%).
/// Supports workflow: CALCULATED → UNDER_REVIEW → APPROVED → LOCKED.
model COAttainment {
  id              String           @id @default(uuid())
  subjectId       String
  cohortId        String
  coId            String
  semester        Int
  academicYear    String
  targetPercent   Float            @default(60)
  achievedPercent Float            @default(0)
  studentCount    Int              @default(0)
  passCount       Int              @default(0)
  status          AttainmentStatus @default(DRAFT)
  calculatedAt    DateTime?
  submittedAt     DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  lockedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  approver        User?            @relation("AttainmentApprover", fields: [approvedBy], references: [id])
  co              CourseOutcome    @relation(fields: [coId], references: [id])
  cohort          Cohort           @relation(fields: [cohortId], references: [id])
  subject         Subject          @relation(fields: [subjectId], references: [id])

  @@unique([subjectId, cohortId, coId, semester, academicYear])
  @@index([subjectId, cohortId, semester])
  @@index([coId])
  @@index([status])
}

/// Program Outcome attainment calculation results.
/// Computed as: Σ(CO_Attainment × CO-PO_Correlation) / Σ(Weights).
/// Critical for NAAC compliance and accreditation reporting.
model POAttainment {
  id              String           @id @default(uuid())
  programId       String
  cohortId        String
  poId            String
  semester        Int
  academicYear    String
  targetPercent   Float            @default(60)
  achievedPercent Float            @default(0)
  weightedSum     Float            @default(0)
  totalWeight     Float            @default(0)
  coCount         Int              @default(0)
  status          AttainmentStatus @default(DRAFT)
  calculatedAt    DateTime?
  submittedAt     DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  lockedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  approver        User?            @relation("POAttainmentApprover", fields: [approvedBy], references: [id])
  cohort          Cohort           @relation(fields: [cohortId], references: [id])
  po              ProgramOutcome   @relation(fields: [poId], references: [id])
  program         Program          @relation(fields: [programId], references: [id])

  @@unique([programId, cohortId, poId, semester, academicYear])
}

model Exam {
  id             String               @id @default(uuid())
  subjectId      String
  cohortId       String
  examType       String
  maxMarks       Int                  @default(30)
  status         ExamStatus           @default(DRAFT)
  teacherId      String?
  createdAt      DateTime             @default(now())
  publishedAt    DateTime?
  customTypeName String?
  duration       Int?
  examDate       DateTime?
  instructions   String?
  passingMarks   Float?
  updatedAt      DateTime?            @default(now()) @updatedAt
  semester       Int
  cohort         Cohort               @relation(fields: [cohortId], references: [id])
  subject        Subject              @relation(fields: [subjectId], references: [id])
  sections       ExamSection[]
  snapshots      ExamSnapshot[]
  feedbacks      Feedback[]
  computedMarks  MarksComputed[]
  unlockRequests MarksUnlockRequest[]
  studentMarks   StudentMark[]

  @@unique([subjectId, cohortId, examType])
  @@index([subjectId, status])
  @@index([teacherId, status])
}

model ExamSection {
  id                String        @id @default(uuid())
  examId            String
  name              String
  sequence          Int
  requiredQuestions Int           @default(1)
  selectionMode     SelectionMode @default(FIRST_N)
  maxMarks          Int
  createdAt         DateTime      @default(now())
  exam              Exam          @relation(fields: [examId], references: [id])
  questions         Question[]
}

model Question {
  id           String         @id @default(uuid())
  sectionId    String
  sequence     Int
  maxMarks     Int
  coId         String?
  bloomLevel   BloomLevel
  isOptional   Boolean        @default(false)
  groupKey     String?
  createdAt    DateTime       @default(now())
  co           CourseOutcome? @relation(fields: [coId], references: [id])
  section      ExamSection    @relation(fields: [sectionId], references: [id])
  subQuestions SubQuestion[]
}

model SubQuestion {
  id           String         @id @default(uuid())
  questionId   String
  label        String
  maxMarks     Int
  coId         String?
  bloomLevel   BloomLevel
  createdAt    DateTime       @default(now())
  studentMarks StudentMark[]
  co           CourseOutcome? @relation(fields: [coId], references: [id])
  question     Question       @relation(fields: [questionId], references: [id])

  @@index([questionId])
  @@index([coId])
  @@index([questionId, coId])
}

model StudentEnrollment {
  id           String     @id @default(uuid())
  studentId    String
  cohortId     String
  departmentId String
  semester     Int        @default(1)
  status       String     @default("active")
  createdAt    DateTime   @default(now())
  subjectId    String?
  cohort       Cohort     @relation(fields: [cohortId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  student      User       @relation(fields: [studentId], references: [id])
  Subject      Subject?   @relation(fields: [subjectId], references: [id])

  @@unique([studentId, cohortId, semester])
  @@index([cohortId, semester])
  @@index([departmentId, status])
}

model TeacherAssignment {
  id           String     @id @default(uuid())
  teacherId    String
  subjectId    String
  cohortId     String
  departmentId String
  semester     Int        @default(1)
  academicYear String
  createdAt    DateTime   @default(now())
  cohort       Cohort     @relation(fields: [cohortId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  subject      Subject    @relation(fields: [subjectId], references: [id])
  teacher      User       @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, subjectId, cohortId, semester, academicYear])
}

model StudentMark {
  id            String      @id @default(uuid())
  examId        String
  studentId     String
  subQuestionId String
  marks         Decimal
  enteredBy     String?
  enteredAt     DateTime    @default(now())
  marksObtained Float
  enteredByUser User?       @relation("MarksEnteredBy", fields: [enteredBy], references: [id])
  exam          Exam        @relation(fields: [examId], references: [id])
  student       User        @relation("StudentMarks", fields: [studentId], references: [id])
  subQuestion   SubQuestion @relation(fields: [subQuestionId], references: [id])

  @@unique([examId, studentId, subQuestionId])
  @@index([examId, studentId])
}

model MarksComputed {
  id                String   @id @default(uuid())
  examId            String
  studentId         String
  totalMarks        Decimal
  selectedQuestions Json
  computedAt        DateTime @default(now())
  exam              Exam     @relation(fields: [examId], references: [id])
  student           User     @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId])
}

model ExamSnapshot {
  id           String   @id @default(uuid())
  examId       String
  snapshotData Json
  createdAt    DateTime @default(now())
  createdBy    String?
  creator      User?    @relation(fields: [createdBy], references: [id])
  exam         Exam     @relation(fields: [examId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  ipAddress   String?
  createdAt   DateTime @default(now())
  description String?
  entityId    String
  entityType  String
  newValue    Json?
  oldValue    Json?
  userAgent   String?
  user        User     @relation("AuditLogActor", fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

/// Defines reusable feedback templates with configurable categories
model FeedbackTemplate {
  id           String                     @id @default(uuid())
  name         String
  description  String?
  departmentId String?
  programId    String?
  isActive     Boolean                    @default(true)
  isDefault    Boolean                    @default(false)
  createdBy    String
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  department   Department?                @relation(fields: [departmentId], references: [id])
  program      Program?                   @relation(fields: [programId], references: [id])
  categories   FeedbackTemplateCategory[]
  feedbacks    TeacherStudentFeedback[]

  @@index([departmentId])
  @@index([programId])
  @@index([isActive])
}

/// Categories within a feedback template (Academic, Behaviour, Communication, etc.)
model FeedbackTemplateCategory {
  id           String                   @id @default(uuid())
  templateId   String
  name         String
  description  String?
  displayOrder Int                      @default(0)
  createdAt    DateTime                 @default(now())
  question     String
  updatedAt    DateTime                 @updatedAt
  options      FeedbackCategoryOption[]
  ratings      FeedbackCategoryRating[]
  template     FeedbackTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, displayOrder])
  @@index([templateId])
}

model FeedbackCategoryOption {
  id         String                   @id @default(uuid())
  categoryId String
  label      String
  points     Int
  order      Int                      @default(0)
  createdAt  DateTime                 @default(now())
  category   FeedbackTemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, order])
}

/// IMMUTABLE teacher feedback record (frozen after lock) - NAAC Evidence
model TeacherStudentFeedback {
  id              String                   @id @default(uuid())
  teacherId       String
  studentId       String
  subjectId       String
  semester        Int
  cohortId        String
  templateId      String
  starRating      Int
  reviewText      String
  status          FeedbackStatus           @default(DRAFT)
  submittedAt     DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  lockedAt        DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  analytics       FeedbackAnalyticsCache?
  categoryRatings FeedbackCategoryRating[]
  approver        User?                    @relation("FeedbackApprover", fields: [approvedBy], references: [id])
  cohort          Cohort                   @relation(fields: [cohortId], references: [id])
  student         User                     @relation("StudentFeedbackReceived", fields: [studentId], references: [id])
  subject         Subject                  @relation(fields: [subjectId], references: [id])
  teacher         User                     @relation("TeacherFeedbackGiven", fields: [teacherId], references: [id])
  template        FeedbackTemplate         @relation(fields: [templateId], references: [id])

  @@unique([teacherId, studentId, subjectId, semester, cohortId])
  @@index([studentId])
  @@index([teacherId])
  @@index([subjectId, cohortId, semester])
  @@index([status])
}

/// Individual category ratings (IMMUTABLE after parent feedback locks)
model FeedbackCategoryRating {
  id         String                   @id @default(uuid())
  feedbackId String
  categoryId String
  rating     Int
  category   FeedbackTemplateCategory @relation(fields: [categoryId], references: [id])
  feedback   TeacherStudentFeedback   @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, categoryId])
  @@index([feedbackId])
}

/// DYNAMIC analytics cache (recalculates on marks change) - NAAC Interpretation
model FeedbackAnalyticsCache {
  id               String                 @id @default(uuid())
  feedbackId       String                 @unique
  avgMarks         Float?
  marksBand        String?
  feedbackScore    Float
  alignmentIndex   Float?
  riskLevel        String
  categoryInsights Json?
  calculatedAt     DateTime               @default(now())
  marksUpdatedAt   DateTime?
  isStale          Boolean                @default(false)
  feedback         TeacherStudentFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([isStale])
  @@index([feedbackId])
}

model ApprovalRequest {
  id           String         @id @default(uuid())
  workflowType WorkflowType
  entityId     String
  requesterId  String
  approverId   String?
  status       ApprovalStatus @default(PENDING)
  comments     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  approver     User?          @relation("Approver", fields: [approverId], references: [id])
  requester    User           @relation("Requester", fields: [requesterId], references: [id])
}

model MarksUnlockRequest {
  id                  String       @id @default(uuid())
  examId              String
  requesterId         String
  reason              String
  hodApprovedAt       DateTime?
  hodApprovedBy       String?
  hodComments         String?
  principalApprovedAt DateTime?
  principalApprovedBy String?
  principalComments   String?
  status              UnlockStatus @default(PENDING)
  unlockExpiresAt     DateTime?
  unlockedAt          DateTime?
  relockedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  exam                Exam         @relation(fields: [examId], references: [id])
  hodApprover         User?        @relation("UnlockHOD", fields: [hodApprovedBy], references: [id])
  principalApprover   User?        @relation("UnlockPrincipal", fields: [principalApprovedBy], references: [id])
  requester           User         @relation("UnlockRequester", fields: [requesterId], references: [id])
}

model Feedback {
  id           String   @id @default(uuid())
  studentId    String
  teacherId    String
  examId       String
  rating       Int
  improvements String[]
  comment      String?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  exam         Exam     @relation(fields: [examId], references: [id])
  student      User     @relation("StudentFeedback", fields: [studentId], references: [id])
  teacher      User     @relation("TeacherFeedback", fields: [teacherId], references: [id])

  @@unique([studentId, examId])
}

model Conversation {
  id           String                    @id @default(uuid())
  type         ConversationType
  name         String?
  description  String?
  avatarUrl    String?
  createdBy    String
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  creator      User                      @relation("ConversationCreator", fields: [createdBy], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@index([type, createdAt])
  @@index([createdBy])
}

model ConversationParticipant {
  id             String          @id @default(uuid())
  conversationId String
  userId         String
  role           ParticipantRole @default(MEMBER)
  joinedAt       DateTime        @default(now())
  lastReadAt     DateTime?
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User            @relation("ConversationParticipants", fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId, role])
}

model Message {
  id             String               @id @default(uuid())
  senderId       String
  content        String
  createdAt      DateTime             @default(now())
  conversationId String
  deletedAt      DateTime?
  isDeleted      Boolean              @default(false)
  isEdited       Boolean              @default(false)
  messageType    MessageType          @default(TEXT)
  updatedAt      DateTime             @updatedAt
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                 @relation("SentMessages", fields: [senderId], references: [id])
  attachments    MessageAttachment[]
  readReceipts   MessageReadReceipt[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageAttachment {
  id         String   @id @default(uuid())
  messageId  String
  fileName   String
  fileSize   Int
  fileType   String
  fileUrl    String
  uploadedAt DateTime @default(now())
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MessageReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation("MessageReadReceipts", fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([userId])
}

model UserPresence {
  id         String   @id @default(uuid())
  userId     String   @unique
  isOnline   Boolean  @default(false)
  lastSeenAt DateTime @default(now())
  socketId   String?
  updatedAt  DateTime @updatedAt
  user       User     @relation("UserPresence", fields: [userId], references: [id])

  @@index([isOnline])
  @@index([lastSeenAt])
}

model GradingRule {
  id            String      @id @default(uuid())
  departmentId  String?
  minPercentage Float
  maxPercentage Float
  grade         String
  gradePoint    Float
  createdAt     DateTime    @default(now())
  department    Department? @relation(fields: [departmentId], references: [id])
}

model FinalMark {
  id            String   @id @default(uuid())
  studentId     String
  subjectId     String
  cohortId      String
  internal1     Float    @default(0)
  internal2     Float    @default(0)
  bestInternal  Float    @default(0)
  externalMarks Float    @default(0)
  totalMarks    Float    @default(0)
  percentage    Float    @default(0)
  grade         String   @default("PENDING")
  gradePoint    Float    @default(0)
  coAttainment  Json?
  status        String   @default("calculated")
  computedAt    DateTime @default(now())
  feedback      String?
  cohort        Cohort   @relation(fields: [cohortId], references: [id])
  student       User     @relation(fields: [studentId], references: [id])
  subject       Subject  @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId, cohortId])
}

model SemesterResult {
  id            String   @id @default(uuid())
  studentId     String
  cohortId      String
  semester      Int
  totalCredits  Int
  earnedCredits Int
  sgpa          Float
  cgpa          Float
  status        String
  createdAt     DateTime @default(now())
  cohort        Cohort   @relation(fields: [cohortId], references: [id])
  student       User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, cohortId, semester])
}

enum Role {
  ADMIN
  PRINCIPAL
  HOD
  TEACHER
  STUDENT
}

enum ExamStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  LOCKED
  SCHEDULED
  COMPLETED
}

enum SelectionMode {
  FIRST_N
  BEST_N
}

enum BloomLevel {
  Remember
  Understand
  Apply
  Analyze
  Evaluate
  Create
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkflowType {
  MARKS_APPROVAL
  PROMOTION_APPROVAL
  COPO_APPROVAL
}

enum MessageType {
  TEXT
  ANNOUNCEMENT
  IMAGE
  FILE
}

enum AttainmentStatus {
  DRAFT
  CALCULATED
  UNDER_REVIEW
  APPROVED
  LOCKED
}

enum FeedbackStatus {
  DRAFT
  SUBMITTED
  APPROVED
  LOCKED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

enum UnlockStatus {
  PENDING
  HOD_APPROVED
  HOD_REJECTED
  PRINCIPAL_APPROVED
  PRINCIPAL_REJECTED
  UNLOCKED
  EXPIRED
  RELOCKED
}

model Attendance {
  id           String           @id @default(uuid())
  studentId    String
  subjectId    String
  departmentId String?
  date         DateTime
  status       AttendanceStatus @default(PRESENT)
  remarks      String?
  recordedBy   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  department   Department?      @relation(fields: [departmentId], references: [id])
  student      User             @relation(fields: [studentId], references: [id])
  subject      Subject          @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId, date])
  @@index([studentId, date])
  @@index([subjectId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}
