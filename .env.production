# Production Environment Variables
# Copy this file to .env and update values

# Node Environment
NODE_ENV=production
PORT=3000

# Database (Update with your production credentials)
POSTGRES_USER=obe_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=obe_db

# For local Docker
DATABASE_URL=postgresql://obe_user:CHANGE_ME_strong_password_here@db:5432/obe_db

# For Railway/Render (they provide this automatically)
# DATABASE_URL=postgresql://user:pass@host:5432/database

# JWT Secret (Generate a strong 256-bit key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_strong_secret_key

# Frontend URL (for CORS)
FRONTEND_URL=https://your-domain.com

# Optional: Error Monitoring
# SENTRY_DSN=https://xxx@sentry.io/xxx
